# 默认自动识别文本文件
* text=auto

# OnStep / C / C++ 源码统一使用 LF
*.ino text eol=lf
*.h   text eol=lf
*.hpp text eol=lf
*.c   text eol=lf
*.cc  text eol=lf
*.cpp text eol=lf

# 常见文本文件统一 LF
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows 脚本
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.pdf  -text
*.zip  -text